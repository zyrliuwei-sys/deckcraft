{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deckcraft",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DATABASE_PROVIDER": "d1",
    "VITE_APP_URL": "https://deckcraft.me",
    "VITE_APP_NAME": "DeckCraft",
    "VITE_APP_DESCRIPTION": "Free, open-source presentation software. Online editor, downloads, tutorials, and PowerPoint comparison.",
    "VITE_APP_LOGO": "/logo.svg",
    "VITE_DEFAULT_LOCALE": "en"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deckcraft",
      "database_id": "666cd6cf-462a-45c7-a7fd-4877fc39d7bc",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [
    {
      "pattern": "deckcraft.me",
      "custom_domain": true
    }
  ]
}
